# ═══════════════════════════════════════════════════════════════
#  BookWise AI - Environment Configuration Example
#  Copy this file to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════════

# ─── Gemini AI API ───────────────────────────────────────────
# Get your free API key from: https://aistudio.google.com/apikey
# Keep this private! Never commit to git!
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Flask Configuration ─────────────────────────────────────
FLASK_SECRET_KEY=your-secret-key-change-this-in-production
FLASK_ENV=development          # Set to 'production' for deployments
FLASK_DEBUG=true               # Set to false in production

# ─── Server Configuration ────────────────────────────────────
PORT=5001                      # Port to run Flask app
HOST=0.0.0.0                   # Listen on all interfaces

# ─── Database (Optional - for future use) ───────────────────
# DATABASE_URL=sqlite:///bookwise.db
# For production: postgresql://user:password@localhost:5432/bookwise

# ─── Redis Cache (Optional) ──────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ─── Document Processing ────────────────────────────────────
MAX_UPLOAD_SIZE_MB=25          # Maximum file upload size
ALLOWED_FORMATS=pdf,docx,txt,html,json,md,xml,csv

# ─── RAG & Vector Search ────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_ENABLED=true
RAG_CHUNK_SIZE=500             # Characters per chunk
RAG_CHUNK_OVERLAP=100          # Overlap between chunks

# ─── AI Model Configuration ─────────────────────────────────
DEFAULT_TEMPERATURE=0.7        # 0=factual, 1=creative
DEFAULT_TOP_P=0.9              # 0.1=focused, 1.0=diverse
MAX_TOKENS=1500                # Max output tokens per response
RATE_LIMIT_REQUESTS=100        # Requests per minute
RATE_LIMIT_WINDOW_SECONDS=60

# ─── Features & Feature Flags ────────────────────────────────
ENABLE_STREAMING=true
ENABLE_RAG=true
ENABLE_DOCUMENT_QA=true
ENABLE_VOICE_INPUT=false       # Web Speech API (frontend)
ENABLE_ANALYTICS=false
ENABLE_USER_PROFILES=false

# ─── Logging & Monitoring ───────────────────────────────────
LOG_LEVEL=INFO                 # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/bookwise.log

# ─── Deployment (for cloud platforms) ───────────────────────
# For Render.com: Set PORT from environment
# For Railway.app: Set PORT from environment
# For Heroku: Set PORT from environment
# For AWS: Adjust as needed
# For DigitalOcean: Use EXPOSED_PORT if needed
